# Fine-grained GitHub token with Contents: Read and write access ONLY to your private storage repository
GITHUB_STORAGE_TOKEN=github_pat_replace_me
GITHUB_STORAGE_OWNER=your-github-username
GITHUB_STORAGE_REPO=fx-project-storage
GITHUB_STORAGE_BRANCH=main
NEXT_PUBLIC_SITE_URL=https://your-project.vercel.app
# Optional: maximum upload size in bytes (default 3500000 ~3.5 MB)
MAX_UPLOAD_BYTES=3500000

# Telegram Bot API (keep private; never use NEXT_PUBLIC_ prefix)
TELEGRAM_BOT_TOKEN=123456789:replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_admin_chat_id
